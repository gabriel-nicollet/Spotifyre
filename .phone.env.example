# Your phone, for the phone-check skill (.agents/skills/phone-check). Copy to .phone.env, which git ignores.
PHONE_UDID=00000000-0000000000000000      # xcrun devicectl list devices
PHONE_HOST=                               # the phone's Tailscale address, empty over USB
APP_BUNDLE=com.example.spotify            # the bundle id your signing gives the app
